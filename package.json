{
  "name": "modpress",
  "version": "1.0.0",
  "description": "ModPress is a WordPress plugin designed to manage and display plugins, mods & extensions in a portfolio.",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "build:watch": "webpack --watch --mode development --config webpack.config.js",
    "replace": "powershell -ExecutionPolicy Bypass -File ./scripts/search-replace.ps1",
    "rename": "node Scripts/rename-plugin.js",
    "i18n:pot": "node scripts/generate-pot.js",
    "i18n:mo": "node scripts/generate-mo.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@crestapps/bootstrap-select": "^1.2.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "@trilbdev/bootstrap-select-country-data": "^1.0.4",
    "bootstrap": "^5.3.8",
    "fontawesome": "^5.6.3",
    "tinymce": "^8.8.2",
    "format": "prettier --write .",
		"format:check": "prettier --check .",
		"format:php": "prettier --write \"src/**/*.php\""
  },
  "devDependencies": {
		"@playwright/test": "^1.65.1",
		"@prettier/plugin-php": "0.26.0",
		"@types/node": "^26.6.6",
		"@wordpress/e2e-test-utils-playwright": "^3.2.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/scripts": "^37.1.0",
		"autoprefixer": "^10.5.4",
		"css-loader": "^7.1.4",
		"gettext-parser": "^9.1.1",
		"html-webpack-plugin": "^5.6.8",
		"mini-css-extract-plugin": "^2.10.2",
		"postcss-loader": "^8.2.1",
		"prettier": "3.10.1",
		"sass": "^1.102.0",
		"sass-loader": "^17.0.0",
		"style-loader": "^4.0.0",
		"webpack": "^5.109.2",
		"webpack-cli": "^7.2.2",
		"webpack-dev-server": "^6.0.0"
	},
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fs-ext-extra-prebuilt@2.2.17": true
  }
}
