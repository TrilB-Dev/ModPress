<?xml version="1.0"?>
<ruleset name="ModPress">
    <description>ModPress PHP coding standards.</description>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase" />
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase" />
        <exclude name="WordPress.NamingConventions.ValidVariableName.InterpolatedVariableNotSnakeCase" />
    </rule>
	<file>src</file>
	<file>tests</file>
	<arg name="basepath" value="." />
	<arg name="colors" />
	<arg name="parallel" value="4" />
	<arg name="extensions" value="php" />
	<arg name="ignore" value="*/vendor/*,*/node_modules/*" />
</ruleset>